# ============================================
# LUMOS COFFEE - Backend Environment Variables
# ============================================
# Copy file này thành .env và điền giá trị thực tế.

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_service_role_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
SUPABASE_ANON_KEY=your_supabase_anon_key

# --- Google Gemini AI (Chatbot & Analytics) ---
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.0-flash     # (Tùy chọn) Model AI, mặc định: gemini-2.0-flash

# --- Server ---
# PORT=3001                          # (Tùy chọn) Port chạy backend, mặc định: 3001
# CORS_ORIGINS=http://localhost:3000  # (Tùy chọn) Danh sách origin cho phép, phân cách bằng dấu phẩy
